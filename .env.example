# AI Studio Environment Configuration Example

# Port the Express + Vite server listens on (defaults to 3000)
PORT=3000

# Server-Side Gemini API Key for AI Computer Vision body analysis
GEMINI_API_KEY=

# Supabase Database Configuration (Optional - falls back automatically to local storage persistence)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
